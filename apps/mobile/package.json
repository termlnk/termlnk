{
  "name": "@termlnk/mobile-app",
  "version": "0.4.1",
  "private": true,
  "description": "termlnk-mobile — Expo SDK 58 fat client",
  "author": "telan <telanflow@gmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "url": "https://github.com/termlnk/termlnk",
    "type": "git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:xterm": "node scripts/build-xterm-webview.mjs",
    "postinstall": "node scripts/build-xterm-webview.mjs",
    "eas-build-post-install": "bash scripts/eas-prepare-rust.sh"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-libsodium",
          "@termlnk/react-native-russh"
        ]
      }
    },
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    }
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-menu/menu": "^2.0.0",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/slot": "^1.5.2",
    "@shopify/flash-list": "^2.3.2",
    "@termlnk/agent-mobile": "workspace:*",
    "@termlnk/auth": "workspace:*",
    "@termlnk/auth-core": "workspace:*",
    "@termlnk/auth-mobile": "workspace:*",
    "@termlnk/core": "workspace:*",
    "@termlnk/database-mobile": "workspace:*",
    "@termlnk/port-forwarding-mobile": "workspace:*",
    "@termlnk/react-native-russh": "workspace:*",
    "@termlnk/sftp-mobile": "workspace:*",
    "@termlnk/sync": "workspace:*",
    "@termlnk/sync-engine": "workspace:*",
    "@termlnk/sync-mobile": "workspace:*",
    "@termlnk/terminal-mobile": "workspace:*",
    "@termlnk/themes": "workspace:*",
    "@wendellhu/redi": "1.1.3",
    "@xterm/addon-fit": "^0.12.0-beta.332",
    "@xterm/xterm": "^6.1.0-beta.336",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "hash-wasm": "^4.12.0",
    "lucide-react-native": "^1.67.0",
    "nativewind": "5.0.0-rc.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.1.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "rxjs": "^7.8.2",
    "secure-remote-password": "^0.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@termlnk/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "babel-plugin-typescript-decorators": "^1.0.5",
    "babel-preset-expo": "~58.0.23",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
