diff --git a/ios/Libsodium.mm b/ios/Libsodium.mm
index fbc745de0b351ca6193930a5682e5fa44589e8bf..e7e294696b240f07e28dba7576342244ff1a7f57 100644
--- a/ios/Libsodium.mm
+++ b/ios/Libsodium.mm
@@ -1,9 +1,16 @@
 #import "Libsodium.h"
 #import <React/RCTBridge+Private.h>
+#import <React/RCTBridgeProxy.h>
 #import <React/RCTUtils.h>
 #import <React/RCTLog.h>
 #import "react-native-libsodium.h"
 
+// RN 0.88 removed RCTCxxBridge. In bridgeless mode `self.bridge` is an RCTBridgeProxy, which still
+// implements `runtime` (declared only in its .mm); expose the selector so we can call it.
+@interface RCTBridgeProxy (LibsodiumRuntime)
+- (void *)runtime;
+@end
+
 @implementation Libsodium
 
 @synthesize bridge=_bridge;
@@ -13,14 +20,15 @@ RCT_EXPORT_MODULE()
 RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(install) {
 
   RCTLogInfo(@"installing libsodium");
-  RCTCxxBridge *cxxBridge = (RCTCxxBridge *)self.bridge;
-  if (!cxxBridge.runtime) {
-    RCTLogInfo(@"libsodium install failure: no cxx bridge runtime");
+  RCTBridgeProxy *bridgeProxy = (RCTBridgeProxy *)self.bridge;
+  void *runtime = [bridgeProxy runtime];
+  if (!runtime) {
+    RCTLogInfo(@"libsodium install failure: no bridge runtime");
     return nil;
   }
 
-  RCTLogInfo(@"calling installLibsodium with cxx bridge runtime");
-  ReactNativeLibsodium::installLibsodium(*(facebook::jsi::Runtime *)cxxBridge.runtime);
+  RCTLogInfo(@"calling installLibsodium with bridge runtime");
+  ReactNativeLibsodium::installLibsodium(*(facebook::jsi::Runtime *)runtime);
   return nil;
 }
 
